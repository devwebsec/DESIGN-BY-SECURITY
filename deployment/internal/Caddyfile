{$SECURITY_COPILOT_HOST:security-copilot.internal} {
    tls internal

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Strict-Transport-Security "max-age=31536000"
    }

    reverse_proxy security-copilot:8080 {
        health_uri /health
        health_interval 30s
        health_timeout 3s
    }
}

http://{$SECURITY_COPILOT_HOST:security-copilot.internal} {
    redir https://{$SECURITY_COPILOT_HOST:security-copilot.internal}{uri} permanent
}
